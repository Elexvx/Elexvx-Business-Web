---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon?: string;
  title?: string;
  message?: string;
  primaryButtonText?: string;
  primaryButtonHref?: string;
  secondaryButtonText?: string;
  id?: string;
}

const {
  icon = 'tabler:speakerphone',
  title = 'New message!',
  message = 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Ipsam ea quo unde vel adipisci blanditiis voluptates eum. Nam, cum minima?',
  primaryButtonText = 'Take a Look',
  primaryButtonHref = '#',
  secondaryButtonText = 'Mark as Read',
  id = 'note-popup',
} = Astro.props;
---

<div id={id} class="note-popup">
  <div class="popup-overlay"></div>
  <div class="card">
    <div class="header">
      <span class="icon">
        <Icon name={icon} />
      </span>
      <p class="alert">{title}</p>
      <button class="close-btn" onclick={`closeNotePopup('${id}')`}>
        <Icon name="tabler:x" />
      </button>
    </div>

    <p class="message">
      {message}
    </p>

    <div class="actions">
      <a class="read" href={primaryButtonHref} onclick={`closeNotePopup('${id}')` + (primaryButtonHref === '#' ? '; return false;' : '')}>
        {primaryButtonText}
      </a>

      <button class="mark-as-read" onclick={`closeNotePopup('${id}')`}>
        {secondaryButtonText}
      </button>
    </div>
  </div>
</div>

<style>
  .note-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .note-popup.show {
    opacity: 1;
    visibility: visible;
  }

  .popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .card {
    position: relative;
    max-width: 400px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    border-width: 1px;
    border-color: rgba(219, 234, 254, 1);
    border-radius: 1rem;
    background-color: rgba(255, 255, 255, 1);
    padding: 1.5rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .note-popup.show .card {
    transform: scale(1);
  }

  .header {
    display: flex;
    align-items: center;
    grid-gap: 1rem;
    gap: 1rem;
    position: relative;
  }

  .icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: rgb(238, 255, 0);
    padding: 0.5rem;
    color: rgb(0, 0, 0);
  }

  .icon :global(svg) {
    height: 1rem;
    width: 1rem;
  }

  .alert {
    font-weight: 600;
    color: rgba(107, 114, 128, 1);
    flex: 1;
    margin: 0;
  }

  .close-btn {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    background: rgba(239, 68, 68, 1);
    color: white;
    border: none;
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .close-btn:hover {
    background: rgba(220, 38, 38, 1);
    transform: scale(1.1);
  }

  .close-btn :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .message {
    margin-top: 1rem;
    color: rgba(107, 114, 128, 1);
    line-height: 1.6;
  }

  .actions {
    margin-top: 1.5rem;
  }

  .actions a,
  .actions button {
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .mark-as-read,
  .read {
    display: inline-block;
    border-radius: 0.5rem;
    width: 100%;
    padding: 0.75rem 1.25rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .read {
    background-color: rgba(59, 130, 246, 1);
    color: rgba(255, 255, 255, 1);
  }

  .read:hover {
    background-color: rgba(37, 99, 235, 1);
    transform: translateY(-1px);
  }

  .mark-as-read {
    margin-top: 0.5rem;
    background-color: rgba(249, 250, 251, 1);
    color: rgba(107, 114, 128, 1);
  }

  .mark-as-read:hover {
    background-color: rgb(230, 231, 233);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .card {
      margin: 1rem;
      padding: 1rem;
    }
  }
</style>

<script>
  // 检查是否已经关闭过弹出框
  function checkNotePopupStatus(id) {
    const dismissed = localStorage.getItem(`note-popup-${id}-dismissed`);
    return dismissed === 'true';
  }

  // 显示弹出框
  function showNotePopup(id) {
    const popup = document.getElementById(id);
    if (popup && !checkNotePopupStatus(id)) {
      setTimeout(() => {
        popup.classList.add('show');
      }, 500); // 延迟500ms显示
    }
  }

  // 关闭弹出框
  function closeNotePopup(id) {
    const popup = document.getElementById(id);
    if (popup) {
      popup.classList.remove('show');
      // 记住用户已经关闭了这个弹出框
      localStorage.setItem(`note-popup-${id}-dismissed`, 'true');
    }
  }

  // 页面加载完成后检查并显示弹出框
  document.addEventListener('DOMContentLoaded', function() {
    const popups = document.querySelectorAll('.note-popup');
    popups.forEach(popup => {
      showNotePopup(popup.id);
    });
  });

  // 点击遮罩层关闭弹出框
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('popup-overlay')) {
      const popup = e.target.closest('.note-popup');
      if (popup) {
        closeNotePopup(popup.id);
      }
    }
  });

  // ESC键关闭弹出框
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const visiblePopup = document.querySelector('.note-popup.show');
      if (visiblePopup) {
        closeNotePopup(visiblePopup.id);
      }
    }
  });

  // 全局函数，供内联事件使用
  window.closeNotePopup = closeNotePopup;
</script>
