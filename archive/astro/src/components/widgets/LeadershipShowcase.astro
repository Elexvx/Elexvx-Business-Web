---
// *******************************************
// 组件：管理层展示（多种布局变体）              **
// *******************************************
// 创建时间：2025-01-27                      **
// *******************************************

import LeaderCard from '~/components/ui/LeaderCard.astro';
import type { Leader } from '~/components/ui/LeaderCard.astro';

export interface Props {
  leaders: Leader[];
  title?: string;
  subtitle?: string;
  layout?: 'grid' | 'carousel' | 'featured' | 'compact';
  maxDisplay?: number;
  showViewAll?: boolean;
  viewAllLink?: string;
}

const { 
  leaders, 
  title = "管理层团队",
  subtitle,
  layout = 'grid',
  maxDisplay,
  showViewAll = false,
  viewAllLink = '/company/leadership'
} = Astro.props;

// 限制显示数量
const displayLeaders = maxDisplay ? leaders.slice(0, maxDisplay) : leaders;

// 根据布局类型设置样式
const layoutConfig = {
  grid: {
    containerClass: 'grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6',
    cardSize: 'md' as const,
    showBio: false
  },
  carousel: {
    containerClass: 'flex overflow-x-auto gap-6 pb-4 snap-x snap-mandatory scrollbar-hide',
    cardSize: 'md' as const,
    showBio: false
  },
  featured: {
    containerClass: 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8',
    cardSize: 'lg' as const,
    showBio: true
  },
  compact: {
    containerClass: 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4',
    cardSize: 'sm' as const,
    showBio: false
  }
};

const config = layoutConfig[layout];
---

<section class="py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- 标题区域 -->
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    <!-- 管理层展示区域 -->
    <div class={config.containerClass}>
      {displayLeaders.map((leader) => (
        <div class={layout === 'carousel' ? 'flex-none w-72 snap-center' : ''}>
          <LeaderCard 
            leader={leader}
            size={config.cardSize}
            showBio={config.showBio}
          />
        </div>
      ))}
    </div>

    <!-- 查看全部按钮 -->
    {showViewAll && maxDisplay && leaders.length > maxDisplay && (
      <div class="text-center mt-12">
        <a 
          href={viewAllLink}
          class="inline-flex items-center px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 shadow-lg hover:shadow-xl"
        >
          查看全部管理层
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
          共 {leaders.length} 位管理层成员
        </p>
      </div>
    )}
  </div>
</section>

<!-- 轮播布局的额外样式 -->
{layout === 'carousel' && (
  <style>
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
  </style>
)}

<!-- 响应式优化 -->
<style>
  @media (max-width: 640px) {
    .grid-cols-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  
  @media (max-width: 480px) {
    .grid-cols-2 {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }
</style>