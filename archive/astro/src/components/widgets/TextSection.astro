--- 
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  title?: string;
  tagline?: string;
}

const { title, tagline, ...attrs } = Astro.props;
---

<section class="py-16 md:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      {tagline && <p class="text-base text-primary-600 dark:text-primary-200 font-bold tracking-wide uppercase">{tagline}</p>}
      {title && <h2 class="text-4xl md:text-5xl font-bold dark:text-white">{title}</h2>}
    </div>
    <div class="prose prose-lg dark:prose-invert max-w-none mx-auto text-center">
      <slot />
    </div>
  </div>
</section>