---
// *******************************************
// 组件：管理层卡片（单个）                    **
// *******************************************
// 创建时间：2025-01-27                      **
// *******************************************

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Leader {
  id: string;
  name: string;
  position: string;
  image: string | ImageMetadata;
  bio?: string;
}

export interface Props {
  leader: Leader;
  showBio?: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const { 
  leader, 
  showBio = false, 
  size = 'md'
} = Astro.props;

// 根据尺寸设置样式 - 移动端统一尺寸优化
const sizeClasses = {
  sm: {
    container: 'w-full max-w-[300px] mx-auto',
    image: 'aspect-[4/3]',
    padding: 'p-2',
    title: 'text-base font-semibold',
    position: 'text-xs',
    bio: 'text-xs'
  },
  md: {
    container: 'w-full max-w-[360px] mx-auto',
    image: 'aspect-[4/3]',
    padding: 'p-3',
    title: 'text-lg font-bold',
    position: 'text-sm',
    bio: 'text-sm'
  },
  lg: {
    container: 'w-full max-w-sm mx-auto',
    image: 'aspect-[4/3]',
    padding: 'p-4',
    title: 'text-xl font-bold',
    position: 'text-base',
    bio: 'text-base'
  }
};

const currentSize = sizeClasses[size];
---

<div class={`${currentSize.container}`}>
  <a 
      href={`/company/leadership/${leader.id}`}
      class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 rounded-xl"
    >
    <article class="w-full h-full bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden flex flex-col">
      <!-- 头像区域 -->
      <div class="aspect-[4/3] overflow-hidden bg-gray-50 dark:bg-gray-800 relative">
        {typeof leader.image === 'string' ? (
          <img
            src={leader.image}
            alt={`${leader.name} - ${leader.position}`}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            srcset={`${leader.image} 1x`}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 384px"
          />
        ) : (
          <Image
            src={leader.image}
            alt={`${leader.name} - ${leader.position}`}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            quality={100}
            widths={[300, 400, 600, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 384px"
          />
        )}
      </div>
      
      <!-- 信息区域 -->
      <div class={`${currentSize.padding} text-center flex-1 flex flex-col justify-center`}>
        <h3 class={`${currentSize.title} text-gray-900 dark:text-white mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200`}>
          {leader.name}
        </h3>
        <p class={`${currentSize.position} leading-relaxed font-medium`} style="color: #0161EF;">
          {leader.position}
        </p>
        
        {showBio && leader.bio && (
          <p class={`${currentSize.bio} text-gray-500 dark:text-gray-400 mt-2 line-clamp-3`}>
            {leader.bio}
          </p>
        )}
      </div>
    </article>
  </a>
</div>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>