---
import Item from '~/components/blog/GridItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
  useIndexLogic?: boolean; // 是否使用首页的索引显示逻辑
}

const { posts, useIndexLogic = false } = Astro.props;
---

<div class="grid gap-6 row-gap-5 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 -mb-6">
  {posts.map((post, index) => (
    <div class={
      `h-full ${
        useIndexLogic ? (
          index === 3 ? "hidden md:block lg:hidden" : 
          index === 2 ? "block md:hidden lg:block" :
          "block"
        ) : "block"
      }`
    }>
      <Item post={post} />
    </div>
  ))}
</div>
