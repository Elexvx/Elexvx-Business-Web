---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

{
  link ? (
    <a 
      href={link}
      class="w-full h-full group block bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden flex flex-col"
    >
      <figure class="relative aspect-[16/9] overflow-hidden flex-shrink-0">
        {
          image ? (
            <Image
              src={image}
              class="object-cover object-center w-full h-full group-hover:scale-102 transition-transform duration-300"
              widths={[400, 900]}
              width={400}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              aspectRatio="16:9"
              layout="cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-700 dark:to-gray-600"></div>
          )
        }
        {
          post.category && (
            <span class="absolute top-3 left-3 px-2 py-1 bg-black/10 dark:bg-white/10 backdrop-blur-md text-xs font-medium rounded-md text-white">
              {post.category.title}
            </span>
          )
        }
      </figure>
      
      <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white leading-tight mb-3 transition-colors duration-200">
          {post.title}
        </h3>
        
        <div class="flex-grow">
          {
            post.excerpt && (
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-2">
                {post.excerpt}
              </p>
            )
          }
        </div>
        
        <time datetime={String(post.publishDate)} class="text-xs text-gray-500 dark:text-gray-400 font-medium mt-4">
          {getFormattedDate(post.publishDate)}
          {
            post.readingTime && (
              <>
                <span class="mx-2 text-gray-300 dark:text-gray-600">•</span>
                {post.readingTime} 分钟阅读
              </>
            )
          }
        </time>
      </div>
    </a>
  ) : (
    <article class="w-full h-full bg-white dark:bg-gray-800 rounded-2xl shadow-sm overflow-hidden flex flex-col">
      <figure class="relative aspect-[16/9] overflow-hidden flex-shrink-0">
        {
          image ? (
            <Image
              src={image}
              class="object-cover object-center w-full h-full"
              widths={[400, 900]}
              width={400}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              aspectRatio="16:9"
              layout="cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-700 dark:to-gray-600"></div>
          )
        }
        {
          post.category && (
            <span class="absolute top-3 left-3 px-2 py-1 bg-black/10 dark:bg-white/10 backdrop-blur-md text-xs font-medium rounded-md text-white">
              {post.category.title}
            </span>
          )
        }
      </figure>
      
      <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white leading-tight mb-3">
          {post.title}
        </h3>
        
        <div class="flex-grow">
          {
            post.excerpt && (
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-2">
                {post.excerpt}
              </p>
            )
          }
        </div>
        
        <time datetime={String(post.publishDate)} class="text-xs text-gray-500 dark:text-gray-400 font-medium mt-4">
          {getFormattedDate(post.publishDate)}
          {
            post.readingTime && (
              <>
                <span class="mx-2 text-gray-300 dark:text-gray-600">•</span>
                {post.readingTime} 分钟阅读
              </>
            )
          }
        </time>
      </div>
    </article>
  )
}
