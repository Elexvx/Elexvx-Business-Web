---
import Layout from '~/layouts/PageLayout.astro';

import HeroPage from '~/components/widgets/HeroPage.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import FeatureSet from '~/components/widgets/FeatureSet.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Brands from '~/components/widgets/Brands.astro';

const metadata = {
  title: '初创公司登陆页面',
};
---

<Layout metadata={metadata}>
  <!-- HeroPage 小部件 ******************* -->
  <HeroPage
    title="我们的初创故事"
    backgroundImage="https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80"
  />

  <!-- FeatureSet 小部件 ************** -->

  <FeatureSet
    title="关于我们"
    subtitle="我们相信将梦想变为惊人现实的魔力。由充满激情的开发人员共同创立，我们致力于简化网站创建过程。我们的模板汇集了 Astro 5.0 的创新和 Tailwind CSS 的多功能性，使您能够前所未有地表达您独特的品牌身份。"
    variant="default"
    columns={2}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FeatureSet>

  <!-- Stats 小部件 ****************** -->

  <Stats
    title="发现 Astrowind 的惊人影响力"
    subtitle="以下数字反映了我们的用户对我们的信任以及我们帮助他们取得的卓越成果。"
    stats={[
      { title: '下载量', amount: 182, endValue: 182, suffix: 'K' },
      { title: '已发布网站', amount: 87, endValue: 87 },
      { title: '用户评分', amount: 4.8, endValue: 4.8 },
      { title: '满意客户', amount: 116, endValue: 116, suffix: 'K' },
    ]}
  />

  <!-- Brands 小部件 ****************** -->

  <Brands
    title="合作伙伴与协作"
    subtitle="在 Astrowind，我们相信协作的力量可以推动创新并创造卓越的体验。"
    icons={[]}
    images={[
      {
        src: 'https://cdn.pixabay.com/photo/2015/05/26/09/37/paypal-784404_1280.png',
        alt: 'Paypal',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2021/12/06/13/48/visa-6850402_1280.png',
        alt: 'Visa',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2013/10/01/10/29/ebay-189064_1280.png',
        alt: 'Ebay',
      },

      {
        src: 'https://cdn.pixabay.com/photo/2015/04/13/17/45/icon-720944_1280.png',
        alt: 'Youtube',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2013/02/12/09/07/microsoft-80658_1280.png',
        alt: 'Microsoft',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2015/04/23/17/41/node-js-736399_1280.png',
        alt: 'Node JS',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2015/10/31/12/54/google-1015751_1280.png',
        alt: 'Google',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2021/12/06/13/45/meta-6850393_1280.png',
        alt: 'Meta',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2013/01/29/22/53/yahoo-76684_1280.png',
        alt: 'Yahoo',
      },
    ]}
  />

  <!-- FeatureSet 小部件 ************** -->

  <FeatureSet
    title="我们提供哪些服务？"
    subtitle="我们提供广泛的网站模板，适用于各种行业和用途，如商业、作品集、电子商务、博客等。"
    variant="default"
    columns={3}
    items={[
      {
        title: '安装说明',
        description: '提供清晰的说明，介绍如何下载购买的模板并将其安装在各种网站平台或内容管理系统上。',
        icon: 'flat-color-icons:document',
      },
      {
        title: '演示和预览',
        description: '提供交互式演示和预览，让客户在购买前可以看到他们选择的模板的外观和功能。',
        icon: 'flat-color-icons:template',
      },
      {
        title: '技术支持',
        description: '为与模板或其实施相关的任何技术问题提供客户支持。',
        icon: 'flat-color-icons:voice-presentation',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FeatureSet>

  <!-- FeatureSet 小部件 *************** -->

  <FeatureSet
    id="features"
    title="我们模板的主要特点"
    subtitle="具备几个关键特性，以有效满足初创企业和企业家的需求。"
    variant="default"
    columns={3}
    items={[
      {
        title: '现代化和专业设计',
        description: '拥有反映当前设计趋势的现代设计，给人以专业的印象。',
        icon: 'tabler:artboard',
      },
      {
        title: '响应式和移动友好',
        description: '无缝适应不同的屏幕尺寸和设备，以确保一致的体验。',
        icon: 'tabler:picture-in-picture',
      },
      {
        title: '可定制性',
        description: '易于定制，允许用户调整设计、颜色、排版和内容以匹配其品牌标识。',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: '快速加载时间',
        description: '为速度而优化，以确保流畅的用户体验和有利的搜索引擎排名。',
        icon: 'tabler:rocket',
      },
      {
        title: '搜索引擎优化 (SEO)',
        description: '在模板结构和代码中融入 SEO 最佳实践，以提高在搜索引擎结果中的可见性。',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: '兼容性',
        description: '模板可在各种内容管理系统和网站构建器中无缝工作。',
        icon: 'tabler:plug-connected',
      },
    ]}
  />

  <!-- FAQs 小部件 ******************* -->

  <FAQs
    title="常见问题"
    items={[
      {
        title: '什么是登陆页面模板？',
        description:
          '登陆页面模板是预先设计的网页布局，专门用作构建有效登陆页面的基础。这些模板旨在吸引访问者的注意力，并引导他们实现特定的行动或目标，例如注册新闻通讯、进行购买或下载资源。',
      },
      {
        title: '我为什么要使用模板？',
        description:
          '一些优点是它们提供了即用型结构，为您节省了大量时间。设计时考虑了用户友好性，并提供了一种经济高效的替代方案，为您省钱的同时仍能提供高质量的结果。',
      },
      {
        title: '我可以在购买前预览模板吗？',
        description: '是的，模板允许您在购买前预览它们。每个模板都有一个“演示”按钮。',
      },
      {
        title: '我需要技术技能才能使用模板吗？',
        description:
          '使用模板不需要高级技术技能，但对网页导航有基本了解并熟悉使用在线工具仍然很有帮助。如果您有更具体的定制需求，您可能需要查阅指南或联系客户支持寻求帮助。',
      },
      {
        title: '我可以在多个网站上使用该模板吗？',
        description:
          '不可以，该模板附带一次性使用许可证，这意味着您只能在一个网站或项目上使用该模板。在其他网站上使用该模板需要购买额外的许可证。',
      },
      {
        title: '如果我需要定制方面的帮助怎么办？',
        description:
          '模板提供了全面的分步指南，引导您完成定制过程。如果您仍有疑问，可以联系我们的客户支持团队。他们可以回答您的问题，提供有关定制的指导，并解决您遇到的任何问题。',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- FeatureSet 小部件 ************** -->

  <FeatureSet
    title="告诉我们如何能帮助您"
    subtitle="我们在这里帮助并回答您可能有的任何问题。"
    variant="default"
    columns={4}
    items={[
      {
        title: '电话',
        description: '致电我们获取即时帮助',
        icon: 'tabler:phone',
      },
      {
        title: '电子邮件',
        description: '写信给我们获取详细支持',
        icon: 'tabler:mail',
      },
      {
        title: '与销售聊天',
        description: '开始聊天了解产品信息',
        icon: 'tabler:message-circle',
      },
      {
        title: '与支持聊天',
        description: '开始聊天获取技术支持',
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <!-- CallToAction 小部件 *********** -->

  <CallToAction
    actions={[
      // {
      //   variant: 'primary',
      //   target: '_blank',
      //   text: '获取模板',
      //   href: 'https://github.com/onwidget/astrowind',
      //   icon: 'tabler:download',
      // },
      {
        text: '了解更多',
        href: '#',
        variant: 'custom',
      },
      {
        text: 'Discover',
        href: '#',
        variant: 'discover',
      },
    ]}
  >
    <Fragment slot="title">成为我们愿景的一部分</Fragment>

    <Fragment slot="subtitle">发现一个充满活力的工作环境，无与伦比的成长机会，以及创造有意义影响的机会。</Fragment>
  </CallToAction>
</Layout>
