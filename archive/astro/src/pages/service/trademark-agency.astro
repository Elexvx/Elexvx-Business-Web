---
// *******************************************
// 页面内容：商标代理服务                      **
// *******************************************
// 创建时间：2025-08-23                       **
// *******************************************

import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import FeatureSet from '~/components/widgets/FeatureSet.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// Hero2组件图片引入
import heroImage from '~/assets/images/idea.jpg';

const metadata = {
  title: '商标代理服务',
};
---

<Layout metadata={metadata}>

  <!-- Hero2 小部件 ******************* -->
  <Hero2
    tagline="商标代理服务"
    title="专业知识产权保护"
    subtitle="为企业品牌发展保驾护航。我们拥有国家商标局认证资质，提供全方位的商标代理服务，让您的品牌获得最佳法律保护，助力企业在激烈的市场竞争中脱颖而出。"
    actions={[
      {
        variant: 'primary',
        text: '免费咨询',
        href: '/company/contact',
        icon: 'tabler:message-circle',
      },
      {
        variant: 'secondary',
        text: '了解服务',
        href: '#services',
        icon: 'tabler:arrow-down',
      },
    ]}
    image={{
      src: heroImage,
      alt: '商标代理服务',
    }}
  />

  <!-- Content 介绍小部件 **************** -->
  <Content
    id="services"
    title="服务概述"
    subtitle="宏翔商道知识产权部门专注于为企业提供专业的商标代理服务，保护您的品牌价值。"
    items={[
      {
        title: '商标注册',
        description: '专业的商标注册服务，确保您的品牌获得法律保护。',
        icon: 'tabler:registered',
      },
      {
        title: '商标查询',
        description: '全面的商标查询分析，降低注册风险，提高成功率。',
        icon: 'tabler:search',
      },
      {
        title: '商标维权',
        description: '专业的商标维权服务，维护您的合法权益。',
        icon: 'tabler:shield-check',
      },
      {
        title: '品牌策划',
        description: '提供品牌战略咨询，助力企业品牌发展。',
        icon: 'tabler:bulb',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80',
      alt: '商标代理服务',
    }}
  />

  <!-- 许可证展示 Brands 小部件 **************** -->
  <!-- <Brands
    title="资质认证"
    subtitle="我们拥有国家商标局认证的专业资质，确保为客户提供合规、专业的商标代理服务"
    images={[
      {
        src: '~/assets/images/brand/1.png',
        alt: '商标代理机构备案证',
      },
      {
        src: '~/assets/images/brand/2.png',
        alt: '知识产权代理机构执业许可证',
      },
      {
        src: '~/assets/images/brand/3.png',
        alt: '专利代理机构执业许可证',
      },
    ]}
  /> -->

  <!-- 服务流程 Steps 小部件 ****************** -->
  <Steps
    title="商标注册流程"
    subtitle="专业的服务流程，确保您的商标注册顺利进行"
    items={[
      {
        title: '商标查询分析',
        description: '全面检索现有商标，分析注册可行性，提供专业建议。',
        icon: 'tabler:search',
      },
      {
        title: '申请材料准备',
        description: '协助客户准备完整的申请材料，确保符合法律要求。',
        icon: 'tabler:file-text',
      },
      {
        title: '提交申请',
        description: '向国家商标局正式提交商标注册申请。',
        icon: 'tabler:send',
      },
      {
        title: '跟踪进度',
        description: '全程跟踪申请进度，及时处理审查意见。',
        icon: 'tabler:clock',
      },
      {
        title: '获得证书',
        description: '成功获得商标注册证书，品牌获得法律保护。',
        icon: 'tabler:certificate',
      },
    ]}
    image={{
      src: heroImage,
      alt: '商标注册流程',
    }}
  />

  <!-- 服务特色 FeatureSet 小部件 *************** -->
  <FeatureSet
    title="服务优势"
    subtitle="为什么选择宏翔商道商标代理服务"
    columns={2}
    items={[
      {
        title: '国家认证',
        description: '拥有国家商标局认证的专业代理资质。',
        icon: 'tabler:certificate',
        classes: {
          icon: 'text-white bg-blue-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '成功率高',
        description: '凭借专业经验，商标注册成功率达95%以上。',
        icon: 'tabler:trending-up',
        classes: {
          icon: 'text-white bg-green-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '快速响应',
        description: '专业团队快速响应，缩短办理周期。',
        icon: 'tabler:rocket',
        classes: {
          icon: 'text-white bg-purple-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '全程服务',
        description: '从查询到注册完成，提供全程专业服务。',
        icon: 'tabler:shield-check',
        classes: {
          icon: 'text-white bg-orange-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
    ]}
  />

  <!-- 服务数据统计 Stats 小部件 ****************** -->
  <!-- <Stats
    title="服务数据"
    subtitle="用数据证明我们的专业实力"
    stats={[
      { title: '服务客户', amount: 800, endValue: 800, suffix: '+' },
      { title: '成功注册', amount: 1500, endValue: 1500, suffix: '+' },
      { title: '注册成功率', amount: 95, endValue: 95, suffix: '%' },
      { title: '服务年限', amount: 8, endValue: 8, suffix: '年' },
    ]}
  /> -->

  <!-- 详细服务内容 Content 小部件 **************** -->
  <Content
    isReversed
    title="专业维权服务"
    subtitle="全方位保护您的商标权益"
    items={[
      {
        title: '侵权监测',
        description: '建立完善的商标侵权监测体系，及时发现侵权行为。',
        icon: 'tabler:eye',
      },
      {
        title: '维权策略',
        description: '制定针对性的维权策略，最大化保护客户利益。',
        icon: 'tabler:target',
      },
      {
        title: '法律支持',
        description: '提供专业的法律支持，必要时启动司法程序。',
        icon: 'tabler:gavel',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80',
      alt: '商标维权服务',
    }}
  />

  <!-- CallToAction 小部件 ******************* -->
  <!-- <CallToAction
    title="立即咨询商标代理服务"
    subtitle="保护您的品牌，从商标注册开始"
    actions={[
      {
        variant: 'primary',
        text: '免费咨询',
        href: '/company/contact',
        target: '_self',
        icon: 'tabler:message-circle',
      },
      {
        variant: 'secondary',
        text: '商标查询',
        href: 'tel:+8625123456789',
        icon: 'tabler:search',
      },
    ]}
  /> -->

</Layout>