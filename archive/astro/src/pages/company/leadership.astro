---
// *******************************************
// 页面内容：管理层介绍                        **
// *******************************************
// 创建时间：2025-01-27                      **
// *******************************************

import Layout from '~/layouts/PageLayout.astro';
import HeroPage from '~/components/widgets/HeroPage.astro';
import LeadershipGrid from '~/components/widgets/LeadershipGrid.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// 导入统一的管理层数据
import { getAllLeaders } from '~/data/leaders';

// 顶部图片引入
import shgfImage from '~/assets/images/shgf.jpg';

// 获取管理层数据
const leaders = getAllLeaders();

const metadata = {
  title: '管理层',
  description: '了解宏翔商道核心管理团队，他们的背景、专业经验及领导愿景。',
};
---

<Layout metadata={metadata}>
  <!-- Hero 区域 -->
  <HeroPage
    tagline="leadership"
    title="管理层"
    subtitle="跨领域高管团队凭借战略视野与实战经验，持续驱动公司的创新与成长。"
    backgroundImage={shgfImage.src}
  />

  <!-- 管理层网格展示 -->
  <LeadershipGrid 
    leaders={leaders}
    tagline="leaders"
    title="核心管理团队"
    subtitle="整合技术、财务与运营专长，这支团队共同擘画宏翔商道的未来蓝图。"
  />

  <!-- 团队理念 -->
  <Content
    tagline="Philosophy"
    title="领导理念"
    subtitle="管理层秉承四大核心理念，引领企业与伙伴共赢。"
    items={[
      {
        title: '创新驱动',
        description: '以技术革新与商业模式迭代，持续创造新价值并保持领先。',
        icon: 'tabler:bulb',
      },
      {
        title: '人才为本',
        description: '打造开放多元的成长环境，激发每一位成员的潜能。',
        icon: 'tabler:users',
      },
      {
        title: '客户至上',
        description: '精准洞察需求、快速响应，用卓越体验赢得长期信任。',
        icon: 'tabler:heart',
      },
      {
        title: '可持续发展',
        description: '兼顾经济、社会与环境三维度，实现长期价值最大化。',
        icon: 'tabler:leaf',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: '协作中的团队',
    }}
  />

  <!-- CallToAction 小部件 *********** -->

  <CallToAction
    actions={[
      // {
      //   variant: 'primary',
      //   target: '_blank',
      //   text: '获取模板',
      //   href: 'https://github.com/onwidget/astrowind',
      //   icon: 'tabler:download',
      // },
      {
        text: '工作机会',
        href: '/company/careers',
        variant: 'uiverse',
      },
    ]}
  >
    <Fragment slot="title">成为我们愿景的一部分</Fragment>

    <Fragment slot="subtitle">发现一个充满活力的工作环境，无与伦比的成长机会，以及创造有意义影响的机会。</Fragment>
  </CallToAction>
  


</Layout>



