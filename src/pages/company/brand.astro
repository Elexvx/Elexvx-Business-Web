---
// *******************************************
// 页面内容：品牌                             **
// *******************************************
// 重构时间：2025-08-04 01:44                 **
// *******************************************
import Layout from '~/layouts/PageLayout.astro';
import HeroPage from '~/components/widgets/HeroPage.astro';
import FeatureSet from '~/components/widgets/FeatureSet.astro';
import Brands from '~/components/widgets/Brands.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import TextSection from '~/components/widgets/TextSection.astro'; 
import TwoColumnContent from '~/components/widgets/TwoColumnContent.astro';

// 顶部图片引入
import shgfImage from '~/assets/images/shgf.jpg';

const metadata = {
  title: '商标品牌',
};
---

<Layout metadata={metadata}>

  <!-- Hero 小部件 ******************* -->
  <HeroPage
    tagline="brand"
    title="商标品牌"
    subtitle="欢迎访问 Elexvx 品牌中心。此处汇集了 logo 规范、品牌语言与市场传播资源，确保全球传播的一致性与专业度。"
    backgroundImage={shgfImage.src}
  />

  <!-- Brands 小部件 **************** -->
  <Brands
    tagline="Brand Gallery"
    title="核心视觉资产"
    subtitle="官方提供的标准化商标文件，可根据场景选择合适版本。"
    images={[
      {
        src: '~/assets/images/brand/1.png',
        alt: '商标',
      },
      {
        src: '~/assets/images/brand/2.png',
        alt: '商标',
      },
      {
        src: '~/assets/images/brand/3.png',
        alt: '商标',
      },
    ]}
  />

  <!-- Content 小部件 **************** -->
  <TwoColumnContent
    tagline="LOGO"
    title="品牌标识"
    subtitle="融合未来科技美学与深层文化底蕴"
    leftTitle="图形标志"
    leftContent={[
      '标准版：全彩渐变，仅限白底或亮度 >95% 的浅色背景；',
      '反白版：纯白单色，适用于深色或复杂背景确保对比度；',
      '单色版：100% 黑 / 100% 白，用于黑白印刷或低墨场景。',
    ]}
    leftIcon="tabler:palette"
    rightTitle="文字标志"
    rightItems={[
      '“E”和“vx” 之间维持 12 px 的安全间隙；',
      '默认配色为 #1E6CFF，必要时可使用单色黑或白。',
    ]}
    rightIcon="tabler:award"
  />
  
  <!-- Content 小部件 **************** -->
  <TwoColumnContent
    tagline="Design Idea"
    title="设计理念与寓意"
    subtitle="每一笔都蕴藏品牌精神"
    leftTitle="命名来源"
    leftContent={[
      'Elexvx 源于 “Electrify Vision X”，象征我们以 AI 点亮未来、探索未知。',
    ]}
    leftIcon="tabler:bulb"
    rightTitle="视觉语言"
    rightItems={[
      '飞梭主符号：代表数据与人才在全球高速流动；',
      '三段尾流：灵感来自摩斯电码 "···—"，寓意 连接 · 共创 · 前行；',
      '渐变蓝：#1E6CFF → #2BD1FF，诠释科技温度与人文关怀的融合。'
    ]}
    rightIcon="tabler:color-swatch"
  />

  <!-- Features 小部件 *************** -->
  <FeatureSet
    id="Dos and Don'ts"
    tagline="Dos and Don'ts"
    title="Logo 使用指南"
    subtitle="请遵循以下守则以维护品牌一致性与完整性"
    columns={2}
    items={[
      //**************************可以 **********************************//
      {
        title: '业务相关性',
        description:
          '仅在与 Elexvx 产品、服务或合作活动直接相关的场景中使用 logo。',
        icon: 'tabler:check',
        classes: {
          icon: 'text-white bg-green-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '遵循官方规范',
        description: `严格按照本指南所示比例、留白与配色使用 logo，并明确标注其归属 Elexvx。`,
        icon: 'tabler:check',
        classes: {
          icon: 'text-white bg-green-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      //**************************不要 **********************************//
      {
        title: '避免杂乱背景',
        description:
          '请勿将 logo 置于花纹或颜色复杂的背景上，以免影响识别。',
        icon: 'tabler:x',
        classes: {
          icon: 'text-white bg-red-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '禁止擅自改动',
        description:
          '不得添加描边、阴影或图案等未经授权的元素，也不得拉伸、旋转或改变比例。',
        icon: 'tabler:x',
        classes: {
          icon: 'text-white bg-red-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '严禁私自变体',
        description:
          '不要自行创建与业务、产品相关的 logo 变体或替代标识。',
        icon: 'tabler:x',
        classes: {
          icon: 'text-white bg-red-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '勿裁剪文字标识',
        description: `保持全称显示，不得遮挡、裁剪或降低可读性。`,
        icon: 'tabler:x',
        classes: {
          icon: 'text-white bg-red-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
    ]}
  />
  
  <!-- 纯文字组件 **************** -->
  <TextSection title="法律声明" >
    <p>
      “宏翔商道 ®” 及其图形标志系 <b>宏翔商道（南京）科技发展有限公司</b> 的注册商标。<br />
      本指南仅供被授权方在符合法律法规及授权范围内使用。<br />
      未经书面许可，任何个人或机构不得擅自修改、复制、散布或再创作。<br />
    </p>
  </TextSection>

</Layout>
