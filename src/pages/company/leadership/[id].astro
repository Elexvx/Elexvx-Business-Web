---
// *******************************************
// 页面内容：管理层个人详情页                  **
// *******************************************
// 创建时间：2025-01-27                      **
// 优化时间：2025-11-20 (数据集中管理)       **
// *******************************************

import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';

// 导入统一的管理层数据
import { leadersData, getAllLeaderIds } from '~/data/leaders';

// 静态路径生成函数 - 自动从数据源生成
export async function getStaticPaths() {
  const leaderIds = getAllLeaderIds();
  return leaderIds.map((id) => ({
    params: { id },
  }));
}

// 获取当前页面的管理层ID
const { id } = Astro.params;
const leader = leadersData[id as keyof typeof leadersData];

// 如果找不到对应的管理层信息，返回404
if (!leader) {
  return Astro.redirect('/404');
}

// 针对龚凯瑞（gkr）和施浩宇（shihaoyu）的长简历进行排版优化（文字环绕图片）
const isFloatLayout = ['gkr', 'shihaoyu'].includes(leader.id);

// 将 bio 按段落分割（处理换行符 \n\n）
const bioParagraphs = leader.bio ? leader.bio.split('\n\n').filter((p: string) => p.trim()) : [];

const metadata = {
  title: `${leader.name} - ${leader.position} - 宏翔商道`,
  description: `了解${leader.name}的专业背景和工作经验，${leader.position}在宏翔商道的职责和成就。`,
};
---

<Layout metadata={metadata}>
  <main>
    <!-- 简化的详情页布局 -->
    <section class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <!-- 返回按钮 - 左上角 -->
        <div class="mb-8">
          <a
            href="/company/leadership"
            class="inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
          >
            <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"
              ></path>
            </svg>
            返回管理层列表
          </a>
        </div>

        <div class={isFloatLayout ? "flow-root" : "grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-2 items-start"}>
          <!-- 左侧：照片 -->
          <div class={isFloatLayout ? "flex justify-center mb-12 md:block md:float-left md:mr-12 md:mb-6 md:w-[45%] lg:w-[40%]" : "flex justify-center md:justify-start"}>
            <div
              class={`overflow-hidden rounded-2xl bg-white shadow-lg dark:bg-gray-800 w-full ${isFloatLayout ? 'max-w-sm sm:max-w-md md:max-w-full' : 'max-w-sm sm:max-w-md md:max-w-xl'}`}
            >
              <Image
                src={leader.image}
                alt={`${leader.name} - ${leader.position}`}
                class="aspect-[4/3] w-full object-cover"
                loading="eager"
                quality={100}
                widths={[400, 800, 1200, 1600]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 800px"
              />
            </div>
          </div>

          <!-- 右侧：姓名、职位和详细介绍 -->
          <div class="">
            <div class="space-y-6">
              <!-- 姓名和职位 -->
              <div>
                <h1 class="text-4xl font-bold text-gray-900 dark:text-white">
                  {leader.name}
                </h1>
                <p class="mt-2 text-xl text-blue-600 dark:text-blue-400 font-medium">
                  {leader.position}
                </p>
              </div>

              <!-- 详细介绍 -->
              {
                bioParagraphs.length > 0 && (
                  <div class="prose prose-lg max-w-none dark:prose-invert">
                    {bioParagraphs.map((paragraph, index) => (
                      <p data-key={index} class={`text-gray-600 dark:text-gray-300 leading-relaxed text-lg indent-[2em] ${isFloatLayout ? 'text-justify' : ''}`}>
                        {paragraph}
                      </p>
                    ))}
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
