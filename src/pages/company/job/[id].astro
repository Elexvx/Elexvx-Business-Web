---
// *******************************************
// 页面内容：招聘职位详情页                   **
// *******************************************
// 创建时间：2025-08-26                      **
// *******************************************

import Layout from '~/layouts/PageLayout.astro';
import { getAllJobs, getJobById, getAllJobIds } from '~/data/jobs';

export async function getStaticPaths() {
  const jobIds = getAllJobIds();
  return jobIds.map((id) => ({ params: { id } }));
}

const id = Astro.params.id;
const job = getJobById(id);

// 如果找不到对应的职位信息，返回404
if (!job) {
  return Astro.redirect('/404');
}

const metadata = {
  title: `${job.title} - ${job.department || '宏翔商道'} - 招聘详情`,
  description: `${job.title}职位详情 - ${job.department || ''}部门招聘，${job.location || ''}工作地点，薪资${job.salary || ''}。立即了解职位要求和福利待遇。`,
};
---

<Layout metadata={metadata}>
  <main>
    <section class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <!-- 返回按钮 - 左上角 -->
        <div class="mb-8">
          <a
            href="/company/careers"
            class="inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
          >
            <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            返回招聘列表
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
          <!-- 主要内容区域 - 3列 -->
          <div class="lg:col-span-3 space-y-12">
            <!-- 职位标题区域 -->
            <div class="bg-gradient-to-r from-blue-400 to-indigo-500 rounded-2xl p-8 text-white shadow-xl">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
                <div class="flex-1">
                  <h1 class="text-4xl font-bold mb-4">{job.title}</h1>
                  <div class="flex flex-wrap gap-4 text-blue-100">
                    {job.department && (
                      <div class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm2 6a2 2 0 11-4 0 2 2 0 014 0zm8 0a2 2 0 11-4 0 2 2 0 014 0z" clip-rule="evenodd"></path>
                        </svg>
                        <span>{job.department}</span>
                      </div>
                    )}
                    {job.location && (
                      <div class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                        </svg>
                        <span>{job.location}</span>
                      </div>
                    )}
                    {job.type && (
                      <div class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                        </svg>
                        <span>{job.type}</span>
                      </div>
                    )}
                  </div>
                  {job.salary && (
                    <div class="mt-4">
                      <div class="text-2xl font-bold text-white">{job.salary}</div>
                    </div>
                  )}
                </div>
              </div>
            </div>

            <!-- 职位描述 -->
            {job.description && (
              <div>
                <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white flex items-center">
                  <svg class="w-6 h-6 mr-3 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"></path>
                  </svg>
                  职位描述
                </h2>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed border-l-4 border-blue-500 pl-6">{job.description}</p>
              </div>
            )}

            <!-- 任职要求 -->
            {job.requirements && job.requirements.length > 0 && (
              <div>
                <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-white flex items-center">
                  <svg class="w-6 h-6 mr-3 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  任职要求
                </h2>
                <ul class="space-y-4">
                  {job.requirements.map((requirement, index) => (
                    <li key={index} class="flex items-start gap-4">
                      <div class="flex-shrink-0 w-6 h-6 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mt-1">
                        <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                      </div>
                      <span class="text-gray-700 dark:text-gray-300 leading-relaxed">{requirement}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- 工作职责 -->
            {job.responsibilities && job.responsibilities.length > 0 && (
              <div>
                <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-white flex items-center">
                  <svg class="w-6 h-6 mr-3 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                  </svg>
                  工作职责
                </h2>
                <ul class="space-y-4">
                  {job.responsibilities.map((responsibility, index) => (
                    <li key={index} class="flex items-start gap-4">
                      <div class="flex-shrink-0 w-6 h-6 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center mt-1">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                      </div>
                      <span class="text-gray-700 dark:text-gray-300 leading-relaxed">{responsibility}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- 福利待遇 -->
            {job.benefits && job.benefits.length > 0 && (
              <div>
                <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-white flex items-center">
                  <svg class="w-6 h-6 mr-3 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg>
                  福利待遇
                </h2>
                <ul class="space-y-3">
                  {job.benefits.map((benefit, index) => (
                    <li key={index} class="flex items-start gap-3">
                      <div class="flex-shrink-0 w-5 h-5 bg-yellow-100 dark:bg-yellow-900 rounded-full flex items-center justify-center mt-1">
                        <svg class="w-3 h-3 text-yellow-600 dark:text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                        </svg>
                      </div>
                      <span class="text-gray-700 dark:text-gray-300 leading-relaxed">{benefit}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- 侧边栏 - 1列 -->
          <aside class="space-y-8">
            <!-- 职位信息 -->
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6">
              <h3 class="text-xl font-bold mb-6 text-gray-900 dark:text-white">职位信息</h3>
              <div class="space-y-4">
                {job.experience && (
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
                      <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm text-gray-500 dark:text-gray-400">工作经验</div>
                      <div class="font-semibold text-gray-900 dark:text-white">{job.experience}</div>
                    </div>
                  </div>
                )}
                {job.department && (
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center">
                      <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm2 6a2 2 0 11-4 0 2 2 0 014 0zm8 0a2 2 0 11-4 0 2 2 0 014 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm text-gray-500 dark:text-gray-400">所属部门</div>
                      <div class="font-semibold text-gray-900 dark:text-white">{job.department}</div>
                    </div>
                  </div>
                )}
                {job.location && (
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-red-100 dark:bg-red-900 rounded-lg flex items-center justify-center">
                      <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm text-gray-500 dark:text-gray-400">工作地点</div>
                      <div class="font-semibold text-gray-900 dark:text-white">{job.location}</div>
                    </div>
                  </div>
                )}
                {job.type && (
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-yellow-100 dark:bg-yellow-900 rounded-lg flex items-center justify-center">
                      <svg class="w-5 h-5 text-yellow-600 dark:text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm text-gray-500 dark:text-gray-400">工作性质</div>
                      <div class="font-semibold text-gray-900 dark:text-white">{job.type}</div>
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- 联系我们 -->
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6">
              <h3 class="text-xl font-bold mb-6 text-gray-900 dark:text-white flex items-center">
                <svg class="w-6 h-6 mr-3 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
                联系我们
              </h3>
              <div class="space-y-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-indigo-100 dark:bg-indigo-900 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                      <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                    </svg>
                  </div>
                  <div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">HR邮箱</div>
                    <a href="mailto:hr@elexvx.com" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300">hr@elexvx.com</a>
                  </div>
                </div>
                <div class="mt-6">
                  <a
                    href={job.applyUrl || '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center w-full px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-colors"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    在线提交简历
                  </a>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
</Layout>