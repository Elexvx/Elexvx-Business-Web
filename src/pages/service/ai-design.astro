---
// *******************************************
// 页面内容：AI设计与训练服务                  **
// *******************************************
// 创建时间：2025-08-23                       **
// *******************************************

import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import FeatureSet from '~/components/widgets/FeatureSet.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// Hero2组件图片引入
import heroImage from '~/assets/images/idea.jpg';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'AI设计与训练服务 - 企业级人工智能解决方案 | 宏翔商道',
  description: '宏翔商道提供专业的AI设计与训练服务，涵盖机器学习、深度学习、计算机视觉、自然语言处理等前沿技术。已为100+企业提供定制化AI解决方案，平均提升业务效率60%。立即咨询获取AI智能化转型方案！',
  canonical: getPermalink('/service/ai-design'),
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>

  <!-- Hero2 小部件 ******************* -->
  <Hero2
    tagline="企业级AI设计与训练服务"
    title="释放AI潜能，驱动商业创新"
    subtitle="宏翔商道集成前沿的机器学习、深度学习、计算机视觉和自然语言处理技术，为企业打造定制化的AI智能化解决方案。从需求分析到模型部署的全流程服务，帮助企业实现智能化转型，平均提升业务效率60%，降低运营成本35%。"
    actions={[
      {
        variant: 'primary',
        text: '免费AI评估',
        href: '/company/contact',
        icon: 'tabler:robot',
      },
      {
        variant: 'secondary',
        text: '查看技术方案',
        href: '#services',
        icon: 'tabler:arrow-down',
      },
    ]}
    image={{
      src: heroImage,
      alt: '企业级AI设计与训练服务',
    }}
  />

  <!-- Content 介绍小部件 **************** -->
  <Content
    id="services"
    title="核心技术优势"
    subtitle="宏翔商道AI团队涵盖机器学习、深度学习、计算机视觉、NLP等前沿技术领域，为企业提供从需求分析到模型部署的全流程 AI 解决方案，已成功服务100+企业客户。"
    items={[
      {
        title: '智能AI模型设计',
        description: '基于企业业务场景设计定制化AI模型，涵盖CNN、RNN、Transformer等先进架构，从概念设计到产业化实现的全流程服务。',
        icon: 'tabler:brain',
      },
      {
        title: '高性能模型训练',
        description: '运用GPU集群和分布式计算技术，提供专业的模型训练服务，支持大模型训练，优化算法性能，大幅提升预测准确性。',
        icon: 'tabler:cpu',
      },
      {
        title: '智能数据处理',
        description: '提供专业的数据清洗、标注、增强和特征工程服务，支持多模态数据处理，为AI训练提供高质量、标准化的数据集。',
        icon: 'tabler:database',
      },
      {
        title: '企业AI系统集成',
        description: '提供专业的AI模型部署、API接口开发和系统集成服务，实现AI模型与企业业务系统的无缝集成，快速实现智能化升级。',
        icon: 'tabler:api',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80',
      alt: 'AI设计与训练服务',
    }}
  />

  <!-- Apple风格卡片展示器 ******************* -->
  <!-- <CardSwitcherIcon
    title="在宏翔商道购买 AI 服务，"
    subtitle="好处多多。"
    linkText="选购 AI 方案 >"
    linkHref="/company/contact"
    cards={[
      {
        id: 'installment',
        title: '机器学习方案任你选。',
        description: '各种方式的机器学习方案，为你更添轻松。',
        icon: 'credit-card'
      },
    ]}
  />  -->


  <!-- AI开发流程 Steps 小部件 ****************** -->
  <Steps
    title="企业级AI项目开发流程"
    subtitle="标准化的AI项目开发流程，确保项目高质量交付和商业价值实现"
    items={[
      {
        title: '业务场景深度调研',
        description: '深入了解客户业务痛点和需求，进行可行性分析，明确AI应用场景、技术路线和商业目标，制定详细的项目实施方案。',
        icon: 'tabler:search',
      },
      {
        title: '智能数据工程',
        description: '设计数据采集策略，执行数据清洗、标注和预处理，构建高质量数据集。应用数据增强、特征工程等技术，为模型训练提供充足的数据支撑。',
        icon: 'tabler:database',
      },
      {
        title: '先进模型架构设计',
        description: '根据业务需求选择最优的模型架构，设计算法流程和技术方案。支持CNN、RNN、Transformer等主流架构，以及最新的大模型技术。',
        icon: 'tabler:brain',
      },
      {
        title: '高性能模型训练',
        description: '运用GPU集群和分布式计算技术，进行大规模模型训练。实时监控训练进度和性能指标，持续调优超参，确保模型达到最优性能。',
        icon: 'tabler:cpu',
      },
      {
        title: '全面模型验证与评估',
        description: '建立完善的模型评估体系，进行多维度性能测试和业务场景验证。包括准确性、鲁棒性、可解释性等多重指标评估，确保模型符合业务需求。',
        icon: 'tabler:check',
      },
      {
        title: '产业化部署与运维',
        description: '提供专业的模型部署服务，支持云原生、容器化部署。建立完善的监控和运维体系，提供7x24小时技术支持和模型优化服务。',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: heroImage,
      alt: 'AI开发流程',
    }}
  />

  <!-- 服务优势 FeatureSet 小部件 *************** -->
  <FeatureSet
    title="为什么选择宏翔商道"
    subtitle="技本领先 · 经验丰富 · 定制化 · 全程保障"
    columns={2}
    items={[
      {
        title: '前沿技术实力',
        description: '掌握GPT、BERT、YOLOv8等最新AI技术和算法，拥有深度学习、计算机视觉、NLP等多领域专家，紧跟国际AI发展前沿趋势。',
        icon: 'tabler:rocket',
        classes: {
          icon: 'text-white bg-blue-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '顶尖专家团队',
        description: '拥有来自知名高校和科技企业的AI专家，平均具朇5+年AI研发经验，成功交付100+企业级AI项目，具备深厚的技术底蕴和实战经验。',
        icon: 'tabler:users',
        classes: {
          icon: 'text-white bg-green-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '深度定制化服务',
        description: '针对不同行业和业务场景，提供从模型设计到部署优化的全定制化AI解决方案，确保每个项目都能完美匹配客户的具体需求。',
        icon: 'tabler:adjustments',
        classes: {
          icon: 'text-white bg-purple-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
      {
        title: '全生命周期支持',
        description: '提供从项目启动、开发实施、上线部署到持续运维的全流程服务，包括7x24小时技术支持、模型更新与优化服务。',
        icon: 'tabler:shield-check',
        classes: {
          icon: 'text-white bg-orange-500 rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0'
        }
      },
    ]}
  />

  <!-- AI项目数据统计 Stats 小部件 ****************** -->
  <Stats
    title="AI项目数据证明专业实力"
    subtitle="用数据证明技术实力，用成果证明服务价值"
    stats={[
      { title: '服务企业客户', amount: 100, endValue: 100, suffix: '+' },
      { title: '成功AI项目', amount: 80, endValue: 80, suffix: '+' },
      { title: '平均效率提升', amount: 60, endValue: 60, suffix: '%' },
      { title: '客户满意度', amount: 98, endValue: 98, suffix: '%' },
    ]}
  />

  <!-- 应用场景 Content 小部件 **************** -->
  <Content
    isReversed
    title="AI技术行业应用场景"
    subtitle="深度理解不同行业特点，提供针对性的AI智能化解决方案"
    items={[
      {
        title: '智能制造业',
        description: '提供智能质检、预测性维护、生产优化等AI应用解决方案，实现制造业数字化转型，提升生产效率和产品质量。',
        icon: 'tabler:robot',
      },
      {
        title: '金融科技业',
        description: '为金融机构提供智能风险控制、算法交易、反欺诈检测等AI解决方案，提升风险管理能力和交易效率，保障金融安全。',
        icon: 'tabler:chart-line',
      },
      {
        title: '智慧医疗业',
        description: '在医学影像分析、辅助诊断、药物研发、健康管理等领域提供AI技术支持，提升医疗服务质量和效率，助力智慧医疗发展。',
        icon: 'tabler:heart-handshake',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80',
      alt: 'AI应用场景',
    }}
  />

  <!-- CallToAction 小部件 ******************* -->
  <CallToAction
    title="开启您的AI智能化之旅"
    subtitle="让专业的AI技术团队助力企业实现智能化转型与业务增长"
    actions={[
      {
        variant: 'primary',
        text: '立即获取AI方案',
        href: '/company/contact',
        target: '_self',
        icon: 'tabler:robot',
      },
      {
        variant: 'secondary',
        text: '预约技术咨询',
        href: 'tel:+8625123456789',
        icon: 'tabler:phone',
      },
    ]}
  />

</Layout>