---
// BackToTop.astro - 置顶按钮组件
---

<button id="back-to-top" class="back-to-top-btn" aria-label="返回顶部">
  <svg class="svgIcon" viewBox="0 0 384 512">
    <path
      d="M214.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L160 141.2V448c0 17.7 14.3 32 32 32s32-14.3 32-32V141.2L329.4 246.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-160-160z"
    ></path>
  </svg>
</button>

<style>
  .back-to-top-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: none;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    overflow: hidden;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    
    /* 日间模式样式 */
    background-color: rgb(59, 130, 246); /* blue-500 */
    box-shadow: 0px 0px 0px 4px rgba(59, 130, 246, 0.25);
  }

  /* 夜间模式样式 */
  :global(.dark) .back-to-top-btn {
    background-color: rgb(20, 20, 20);
    box-shadow: 0px 0px 0px 4px rgba(180, 160, 255, 0.253);
  }

  .svgIcon {
    width: 12px;
    transition: all 0.3s ease;
  }

  .svgIcon path {
    fill: white;
  }

  .back-to-top-btn:hover {
    width: 140px;
    border-radius: 50px;
    background-color: rgb(37, 99, 235); /* blue-600 */
    align-items: center;
  }

  :global(.dark) .back-to-top-btn:hover {
    background-color: rgb(181, 160, 255);
  }

  .back-to-top-btn:hover .svgIcon {
    transform: translateY(-200%);
  }

  .back-to-top-btn::before {
    position: absolute;
    bottom: -20px;
    content: "回到顶部";
    color: white;
    font-size: 0px;
    white-space: nowrap;
  }

  .back-to-top-btn:hover::before {
    font-size: 13px;
    opacity: 1;
    bottom: unset;
    transition: all 0.3s ease;
  }

  /* 显示状态 */
  .back-to-top-btn.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .back-to-top-btn {
      bottom: 20px;
      right: 20px;
      width: 45px;
      height: 45px;
    }

    .back-to-top-btn:hover {
      width: 120px;
    }

    .back-to-top-btn:hover::before {
      font-size: 12px;
    }
  }
</style>

<script>
  // 置顶按钮功能
  function initBackToTop() {
    const backToTopBtn = document.getElementById('back-to-top');
    if (!backToTopBtn) return;

    // 监听滚动事件
    function handleScroll() {
      if (window.pageYOffset > 300) {
        backToTopBtn.classList.add('show');
      } else {
        backToTopBtn.classList.remove('show');
      }
    }

    // 点击返回顶部
    function scrollToTop() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    }

    // 绑定事件
    window.addEventListener('scroll', handleScroll);
    backToTopBtn.addEventListener('click', scrollToTop);

    // 初始检查
    handleScroll();
  }

  // 页面加载完成后初始化
  document.addEventListener('DOMContentLoaded', initBackToTop);
  
  // 对于 Astro 的客户端导航
  document.addEventListener('astro:page-load', initBackToTop);
</script>