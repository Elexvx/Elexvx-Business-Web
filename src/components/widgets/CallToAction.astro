---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  actions = await Astro.slots.render('actions'),

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <!-- 彩色渐变容器 -->
  <div class="gradient-border-container">
    <div class="gradient-content-wrapper">
      <!-- 标题内容 -->
      <div class="cta-content">
        <!-- 直接创建渐变标题 -->
        {title && (
          <h2 class="gradient-title-direct text-3xl md:text-4xl font-bold tracking-tighter mb-4 font-heading leading-tight">
            {title}
          </h2>
        )}
        {subtitle && (
          <p class="gradient-subtitle-direct text-xl mb-4 leading-relaxed">
            {subtitle}
          </p>
        )}
        {tagline && (
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-4">
            {tagline}
          </p>
        )}
        
        {actions && (
          <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 mt-6">
            {Array.isArray(actions) ? (
              actions.map((action) => (
                <div class="flex w-full sm:w-auto">
                  <Button {...(action || {})} class="w-full sm:mb-0" variant={action.variant} />
                </div>
              ))
            ) : (
              <Fragment set:html={actions} />
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</WidgetWrapper>

<style>
  .gradient-border-container {
    @apply relative;
    border-radius: 32px;
    --igradient: linear-gradient(90deg, #0894FF 0%, #C959DD 34%, #FF2E54 68%, #FF9004);
    background: var(--igradient);
    padding: 2px;
    filter: drop-shadow(0 0 20px rgba(8, 148, 255, 0.15));
  }
  
  .gradient-border-container::before {
    display: none;
  }
  
  .gradient-content-wrapper {
    @apply bg-white dark:bg-gray-900 relative text-center w-full;
    border-radius: 30px;
    padding: 2rem 2rem;
    position: relative;
    z-index: 1;
    overflow: hidden;
    box-shadow: inset 0 2px 20px rgba(8, 148, 255, 0.08), 
                inset 0 -2px 20px rgba(255, 46, 84, 0.08),
                inset 2px 0 20px rgba(201, 89, 221, 0.08),
                inset -2px 0 20px rgba(255, 144, 4, 0.08);
  }
  
  /* 暗色模式下的内侧晕影 */
  .dark .gradient-content-wrapper {
    box-shadow: inset 0 2px 20px rgba(8, 148, 255, 0.06), 
                inset 0 -2px 20px rgba(255, 46, 84, 0.06),
                inset 2px 0 20px rgba(201, 89, 221, 0.06),
                inset -2px 0 20px rgba(255, 144, 4, 0.06);
  }
  
  .gradient-content-wrapper::before {
    content: '';
    @apply absolute inset-0 opacity-5;
    background: radial-gradient(circle at 20% 20%, #3B82F6 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, #A855F7 0%, transparent 50%),
                radial-gradient(circle at 40% 60%, #EC4899 0%, transparent 50%);
  }
  
  .cta-content {
    @apply relative z-10;
  }
  
  .gradient-title,
  .cta-content h2,
  .gradient-content-wrapper h2,
  .gradient-title-direct {
    background: linear-gradient(90deg, #0894FF 0%, #3B82F6 20%, #8B5CF6 40%, #A855F7 60%, #EC4899 80%, #FF9004 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    background-clip: text !important;
    color: transparent !important;
    line-height: 1.2 !important;
  }
  
  .gradient-subtitle,
  .cta-content p,
  .gradient-content-wrapper p,
  .gradient-subtitle-direct {
    color: #8B8B8D !important;
    background: none !important;
    -webkit-background-clip: unset !important;
    -webkit-text-fill-color: unset !important;
    background-clip: unset !important;
    font-size: 1.1rem !important;
    line-height: 1.5 !important;
  }
  
  /* 暗色模式下的样式 */
  .dark .gradient-title,
  .dark .cta-content h2,
  .dark .gradient-content-wrapper h2,
  .dark .gradient-title-direct {
    background: linear-gradient(90deg, #60A5FA 0%, #3B82F6 20%, #A78BFA 40%, #C084FC 60%, #F472B6 80%, #FB923C 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    background-clip: text !important;
    color: transparent !important;
  }
  
  .dark .gradient-subtitle,
  .dark .cta-content p,
  .dark .gradient-content-wrapper p,
  .dark .gradient-subtitle-direct {
    color: #A1A1AA !important;
    background: none !important;
    -webkit-background-clip: unset !important;
    -webkit-text-fill-color: unset !important;
    background-clip: unset !important;
  }
  
  /* 响应式调整 */
  @media (max-width: 768px) {
    .gradient-border-container {
      border-radius: 24px;
      padding: 2px;
    }
    
    .gradient-content-wrapper {
      border-radius: 22px;
      padding: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    .gradient-border-container {
      border-radius: 40px;
      padding: 3px;
    }
    
    .gradient-content-wrapper {
      border-radius: 37px;
      padding: 4rem;
    }
  }
</style>
