---
// *******************************************
// 组件：招聘岗位网格展示                     **
// *******************************************
// 创建时间：2025-01-27                      **
// *******************************************

import JobCard from '~/components/ui/JobCard.astro';
import type { Job } from '~/components/ui/JobCard.astro';

export interface Props {
  jobs: Job[];
  title?: string;
  tagline?: string;
  subtitle?: string;
  cardSize?: 'sm' | 'md' | 'lg';
  columns?: {
    sm?: number;
    md?: number;
    lg?: number;
    xl?: number;
    '2xl'?: number;
  };
}

const { 
  jobs, 
  title = "热招职位",
  tagline,
  subtitle,
  cardSize = 'md',
  columns = {
    sm: 1,
    md: 2,
    lg: 3,
    xl: 3,
    '2xl': 3
  }
} = Astro.props;

// 网格布局类名 - 响应式设计
const gridCols = 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3';
---

<section class="py-12 bg-gray-50 dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    {(title || tagline || subtitle) && (
      <div class="mb-8 text-center md:mb-12">
        {tagline && (
           <p class="text-base font-bold tracking-wide uppercase text-tagline mb-2">
             {tagline}
           </p>
         )}
        {title && (
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            {title}
          </h2>
        )}
        {subtitle && (
           <p class="mt-4 text-xl text-muted dark:text-slate-400 max-w-3xl mx-auto">
             {subtitle}
           </p>
         )}
      </div>
    )}
    
    <div class={`grid gap-6 md:gap-8 items-stretch ${gridCols}`}>
      {jobs.map((job) => (
        <div class="h-full">
          <JobCard 
            job={job} 
            size={cardSize}
          />
        </div>
      ))}
    </div>
  </div>
</section>