---
import { Icon } from 'astro-icon/components';

export interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  leftTitle?: string;
  leftContent?: string | string[];
  leftIcon?: string;
  rightTitle?: string;
  rightItems?: string[];
  rightContent?: string;
  rightIcon?: string;
  bgClass?: string;
}

const {
  tagline,
  title,
  subtitle,
  leftTitle,
  leftContent,
  leftIcon = 'tabler:check',
  rightTitle,
  rightItems,
  rightContent,
  rightIcon = 'tabler:check',
  bgClass
} = Astro.props;
---

<section class="relative py-16 md:py-20">
  {bgClass && (
    <div class={`absolute inset-0 ${bgClass}`}></div>
  )}
  <slot name="bg" />
  
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    {(tagline || title || subtitle || Astro.slots.has('header')) && (
      <div class="mb-12 text-center">
        {tagline && (
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-4">
            {tagline}
          </p>
        )}
        {title && (
          <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading">
            {title.includes(':') ? (
              <>
                {title.split(':')[0]}:
                <br class="block sm:hidden" />
                <span class="sm:whitespace-nowrap">{title.split(':')[1].trim()}</span>
              </>
            ) : (
              title
            )}
          </h2>
        )}
        {subtitle && (
          <p class="max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400">
            {subtitle}
          </p>
        )}
        <slot name="header" />
      </div>
    )}
    
    <div class="grid md:grid-cols-2 gap-10">
      <div>
        {leftTitle && (
          <h3 class="text-2xl font-bold tracking-tighter mb-4 font-heading">
            {leftTitle}
          </h3>
        )}
        {leftContent && (
          Array.isArray(leftContent) ? (
            <ul class="space-y-4">
              {leftContent.map((item) => (
                <li class="flex">
                  <Icon name={leftIcon} class="w-7 h-7 mr-2 text-green-600" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-xl text-muted dark:text-slate-400">
              {leftContent}
            </p>
          )
        )}
        <slot name="left" />
      </div>
      
      <div>
        {rightTitle && (
          <h3 class="text-2xl font-bold tracking-tighter mb-4 font-heading">
            {rightTitle}
          </h3>
        )}
        {rightContent && (
          <p class="text-xl text-muted dark:text-slate-400">
            {rightContent}
          </p>
        )}
        {rightItems && rightItems.length > 0 && (
          <ul class="space-y-4">
            {rightItems.map((item) => (
              <li class="flex">
                <Icon name={rightIcon} class="w-7 h-7 mr-2 text-green-600" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}
        <slot name="right" />
      </div>
    </div>
  </div>
</section>