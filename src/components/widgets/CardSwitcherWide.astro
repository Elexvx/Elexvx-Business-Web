---
// *******************************************
// 组件：Apple风格宽屏图片轮播组件             **
// *******************************************
// 创建时间：2025-08-24                      **
// 特点：宽屏显示，中心卡片突出，两侧露出       **
// *******************************************

import { Image } from 'astro:assets';

export interface WideImageCard {
  id: string;
  title: string;
  subtitle: string;
  image: string | ImageMetadata;
  alt?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  cards: WideImageCard[];
}

const {
  title = "创新技术方案，",
  subtitle = "推动未来发展。",
  description = "我们致力于提供前沿的技术解决方案，通过创新驱动企业数字化转型，\n为客户创造更大的商业价值。",
  cards = []
} = Astro.props;
---

<section class="apple-wide-carousel-section">
  <div class="mx-auto max-w-full px-4 sm:px-6 lg:px-8 py-20">
    <!-- 标题区域 -->
    <div class="text-center mb-16">
      <h1 class="apple-wide-carousel-title">{title}</h1>
      <h2 class="apple-wide-carousel-subtitle">{subtitle}</h2>
      <p class="apple-wide-carousel-description">{description}</p>
    </div>

    <!-- 宽屏轮播区域 -->
    <div class="apple-wide-carousel-container">
      <div class="apple-wide-carousel-viewport">
        <div class="apple-wide-carousel-track" id="wideCarouselTrack">
          {cards.map((card, index) => (
            <div class="apple-wide-carousel-slide" data-index={index}>
              <div class="apple-wide-card-image">
                {typeof card.image === 'string' ? (
                  <img
                    src={card.image}
                    alt={card.alt || card.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={card.image}
                    alt={card.alt || card.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    widths={[800, 1200, 1600, 2000]}
                    sizes="(max-width: 768px) 800px, (max-width: 1200px) 1200px, 1600px"
                  />
                )}
                
                <!-- 文字覆盖层 -->
                <div class="apple-wide-card-overlay">
                  <div class="apple-wide-card-content">
                    <h3 class="apple-wide-card-title">{card.title}</h3>
                    <p class="apple-wide-card-subtitle">{card.subtitle}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- 底部控制 -->
      <div class="apple-wide-carousel-controls">
        <div></div> <!-- 空白占位 -->
        
        <div class="apple-wide-nav-buttons">
          <button class="apple-wide-nav-btn" id="widePrevBtn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button class="apple-wide-nav-btn" id="wideNextBtn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
</section>

<style>
  .apple-wide-carousel-section {
    @apply bg-white dark:bg-gray-900;
  }
  
  .apple-wide-carousel-title {
    @apply text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight mb-2 font-heading;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .apple-wide-carousel-subtitle {
    @apply text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight mb-8 font-heading;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .apple-wide-carousel-description {
    @apply text-lg text-gray-600 dark:text-gray-400 max-w-4xl mx-auto leading-relaxed;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    white-space: pre-line;
  }
  
  .apple-wide-carousel-container {
    @apply relative;
    /* 防止横向滚动条 */
    overflow-x: hidden;
    width: 100%;
    max-width: 100vw;
  }
  
  .apple-wide-carousel-viewport {
    @apply overflow-hidden relative;
    /* 隐藏溢出内容，防止横向滚动条 */
    width: 100%;
  }
  
  .apple-wide-carousel-track {
    @apply flex transition-transform duration-700 ease-in-out;
    /* 轨道居中对齐 */
    justify-content: flex-start;
    align-items: center;
    gap: 1.5rem; /* 统一间距 */
  }
  
  /* 克隆卡片样式 */
  .apple-wide-carousel-slide.cloned {
    /* 继承所有原始卡片样式 */
  }
  
  .apple-wide-carousel-slide {
    @apply flex-none transition-all duration-700 ease-in-out;
    width: 75%; /* 统一卡片宽度 */
    min-width: 75%; /* 确保最小宽度 */
    max-width: 75%; /* 确保最大宽度 */
    transform-origin: center;
    border-radius: 1.5rem; /* 24px圆角 */
    overflow: hidden;
    flex-shrink: 0; /* 防止收缩 */
    flex-grow: 0; /* 防止扩展 */
  }
  
  /* 平板端调整 */
  @media (max-width: 1024px) {
    .apple-wide-carousel-slide {
      width: 80%;
      min-width: 80%;
      max-width: 80%;
      flex-shrink: 0;
      flex-grow: 0;
    }
    
    .apple-wide-carousel-track {
      gap: 1rem;
    }
  }
  
  /* 移动端调整 */
  @media (max-width: 768px) {
    .apple-wide-carousel-slide {
      width: 90%;
      min-width: 90%;
      max-width: 90%;
      flex-shrink: 0;
      flex-grow: 0;
    }
    
    .apple-wide-carousel-track {
      gap: 0.75rem;
    }
  }
  
  /* 中心卡片样式 */
  .apple-wide-carousel-slide.center {
    transform: scale(1);
    filter: blur(0px);
    opacity: 1;
    z-index: 3;
  }
  
  /* 侧边卡片样式 - 保持相同大小，仅添加模糊和透明度效果 */
  .apple-wide-carousel-slide.side {
    transform: scale(1); /* 与中心卡片相同大小 */
    filter: blur(4px); /* 保持模糊效果 */
    opacity: 0.6; /* 保持透明度效果 */
    z-index: 1;
  }
  
  /* 移动端保持较轻的效果 */
  @media (max-width: 768px) {
    .apple-wide-carousel-slide.side {
      filter: blur(1px);
      opacity: 0.75;
      transform: scale(1); /* 移动端也保持相同大小 */
    }
  }
  
  .apple-wide-card-image {
    @apply relative overflow-hidden w-full;
    height: 28rem; /* 统一固定高度 */
    min-height: 28rem; /* 确保最小高度 */
    max-height: 28rem; /* 确保最大高度 */
    aspect-ratio: 21/9; /* 保持宽屏比例 */
    border-radius: inherit; /* 继承父元素圆角 */
    /* 双重约束确保完全相同尺寸 */
    box-sizing: border-box;
    flex-shrink: 0;
  }
  
  /* 平板端调整 */
  @media (max-width: 1024px) {
    .apple-wide-card-image {
      height: 24rem;
      min-height: 24rem;
      max-height: 24rem;
    }
  }
  
  /* 移动端调整 */
  @media (max-width: 768px) {
    .apple-wide-card-image {
      height: 18rem;
      min-height: 18rem;
      max-height: 18rem;
      aspect-ratio: 16/9;
    }
  }
  
  .apple-wide-card-overlay {
    @apply absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent;
    @apply flex flex-col justify-between p-8;
  }
  
  /* 移动端调整 */
  @media (max-width: 768px) {
    .apple-wide-card-overlay {
      @apply p-6;
    }
  }
  
  .apple-wide-card-content {
    @apply mt-auto;
  }
  
  .apple-wide-card-title {
    @apply text-3xl lg:text-4xl font-semibold text-white mb-3 leading-tight;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  /* 移动端调整 */
  @media (max-width: 768px) {
    .apple-wide-card-title {
      @apply text-2xl mb-2;
    }
  }
  
  .apple-wide-card-subtitle {
    @apply text-xl text-white/90 leading-relaxed;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  /* 移动端调整 */
  @media (max-width: 768px) {
    .apple-wide-card-subtitle {
      @apply text-lg;
    }
  }
  
  .apple-wide-carousel-controls {
    @apply flex justify-between items-center mt-12;
  }
  
  /* 移除播放按钮样式 */
  
  .apple-wide-nav-buttons {
    @apply flex space-x-3;
  }
  
  .apple-wide-nav-btn {
    @apply w-12 h-12 bg-gray-100 dark:bg-gray-800 rounded-full;
    @apply flex items-center justify-center text-gray-600 dark:text-gray-400;
    @apply hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors;
  }
</style>

<script>
  class AppleWideCarousel {
    track: HTMLElement | null;
    originalSlides: NodeListOf<Element>;
    allSlides: NodeListOf<Element>;
    prevBtn: HTMLElement | null;
    nextBtn: HTMLElement | null;
    currentIndex: number;
    originalSlidesCount: number;
    isTransitioning: boolean;
    
    constructor() {
      this.track = document.getElementById('wideCarouselTrack');
      this.originalSlides = document.querySelectorAll('.apple-wide-carousel-slide');
      this.prevBtn = document.getElementById('widePrevBtn');
      this.nextBtn = document.getElementById('wideNextBtn');
      this.originalSlidesCount = this.originalSlides.length;
      this.currentIndex = this.originalSlidesCount; // 从第一个真实卡片开始
      this.isTransitioning = false;
      
      this.init();
    }
    
    init() {
      this.createInfiniteLoop();
      this.setupEventListeners();
      this.updateCarousel(false); // 初始化时不需要动画
      this.updateSlideStyles();
    }
    
    createInfiniteLoop() {
      if (!this.track || this.originalSlidesCount === 0) return;
      
      // 克隆最后几个卡片到开头
      for (let i = this.originalSlidesCount - 1; i >= 0; i--) {
        const clone = this.originalSlides[i].cloneNode(true) as HTMLElement;
        clone.classList.add('cloned');
        this.track.insertBefore(clone, this.track.firstChild);
      }
      
      // 克隆前几个卡片到末尾
      for (let i = 0; i < this.originalSlidesCount; i++) {
        const clone = this.originalSlides[i].cloneNode(true) as HTMLElement;
        clone.classList.add('cloned');
        this.track.appendChild(clone);
      }
      
      // 更新所有卡片的引用
      this.allSlides = this.track.querySelectorAll('.apple-wide-carousel-slide');
    }
    
    setupEventListeners() {
      this.prevBtn?.addEventListener('click', () => this.prev());
      this.nextBtn?.addEventListener('click', () => this.next());
      
      // 监听窗口大小变化
      window.addEventListener('resize', () => {
        this.updateCarousel(false);
        this.updateSlideStyles();
      });
      
      // 监听过渡结束事件
      this.track?.addEventListener('transitionend', () => {
        this.handleTransitionEnd();
      });
    }
    
    updateSlideStyles() {
      this.allSlides.forEach((slide, index) => {
        const slideElement = slide as HTMLElement;
        slideElement.classList.remove('center', 'side');
        
        if (index === this.currentIndex) {
          slideElement.classList.add('center');
        } else {
          slideElement.classList.add('side');
        }
      });
    }
    
    prev() {
      if (this.isTransitioning) return;
      
      this.isTransitioning = true;
      this.currentIndex--;
      this.updateCarousel(true);
      this.updateSlideStyles();
    }
    
    next() {
      if (this.isTransitioning) return;
      
      this.isTransitioning = true;
      this.currentIndex++;
      this.updateCarousel(true);
      this.updateSlideStyles();
    }
    
    updateCarousel(withTransition = true) {
      if (!this.track || this.allSlides.length === 0) return;
      
      const viewport = this.track.parentElement;
      if (!viewport) return;
      
      const containerWidth = viewport.offsetWidth;
      const slideElement = this.allSlides[0] as HTMLElement;
      const slideWidth = slideElement.offsetWidth;
      const gap = window.innerWidth >= 1024 ? 24 : (window.innerWidth >= 768 ? 16 : 12);
      
      const centerOffset = (containerWidth - slideWidth) / 2;
      const slideOffset = (slideWidth + gap) * this.currentIndex;
      const translateX = centerOffset - slideOffset;
      
      // 设置过渡动画
      this.track.style.transition = withTransition ? 'transform 700ms ease-in-out' : 'none';
      this.track.style.transform = `translateX(${translateX}px)`;
    }
    
    handleTransitionEnd() {
      this.isTransitioning = false;
      
      // 检查是否需要重置位置（无缝循环）
      if (this.currentIndex >= this.allSlides.length - this.originalSlidesCount) {
        // 到达右侧克隆区域，跳转到左侧对应位置
        this.currentIndex = this.originalSlidesCount;
        this.updateCarousel(false);
      } else if (this.currentIndex < this.originalSlidesCount) {
        // 到达左侧克隆区域，跳转到右侧对应位置
        this.currentIndex = this.allSlides.length - this.originalSlidesCount - 1;
        this.updateCarousel(false);
      }
      
      this.updateSlideStyles();
    }
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    new AppleWideCarousel();
  });
</script>