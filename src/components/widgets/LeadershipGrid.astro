---
// *******************************************
// 组件：管理层网格展示                       **
// *******************************************
// 创建时间：2025-01-27                      **
// 更新时间：2025-01-27 - 模块化重构          **
// *******************************************

import LeaderCard from '~/components/ui/LeaderCard.astro';
import type { Leader } from '~/components/ui/LeaderCard.astro';

export interface Props {
  leaders: Leader[];
  title?: string;
  tagline?: string;
  subtitle?: string;
  cardSize?: 'sm' | 'md' | 'lg';
  showBio?: boolean;
  columns?: {
    sm?: number;
    md?: number;
    lg?: number;
    xl?: number;
    '2xl'?: number;
  };
}

const { 
  leaders, 
  title = "管理层简介",
  tagline,
  subtitle,
  cardSize = 'md',
  showBio = false,
  columns = {
    sm: 2,
    md: 3,
    lg: 4,
    xl: 5,
    '2xl': 6
  }
} = Astro.props;

// 网格布局类名 - 动态调整：8个为一行4个，6个为一行3个
let gridCols = 'grid-cols-1 md:grid-cols-2'; // 默认移动端/平板端

if (leaders.length === 8) {
  gridCols += ' lg:grid-cols-4';
} else if (leaders.length === 6) {
  gridCols += ' lg:grid-cols-3';
} else {
  // 其他数量时的默认回退逻辑
  gridCols += ' lg:grid-cols-3 xl:grid-cols-4';
}
---

<section class="py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    {(title || tagline || subtitle) && (
      <div class="mb-8 text-center md:mb-8">
        {tagline && (
           <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
             {tagline}
           </p>
         )}
        {title && (
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            {title}
          </h2>
        )}
        {subtitle && (
           <p class="mt-4 text-xl text-muted dark:text-slate-400 max-w-3xl mx-auto">
             {subtitle}
           </p>
         )}
      </div>
    )}
    
    <div class={`grid gap-6 md:gap-8 ${gridCols}`}>
      {leaders.map((leader) => (
        <LeaderCard 
          leader={leader} 
          cardSize={cardSize} 
          showBio={showBio} 
        />
      ))}
    </div>
  </div>
</section>