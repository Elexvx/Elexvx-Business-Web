---
// *******************************************
// 组件：Apple风格图片轮播组件                **
// *******************************************
// 创建时间：2025-08-23                      **
// 更新时间：2025-08-23 - Apple官网风格重设计  **
// *******************************************

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface ImageCard {
  id: string;
  title: string;
  subtitle: string;
  image: string | ImageMetadata;
  alt?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  cards: ImageCard[];
}

const {
  title = "和教育工作者并肩，",
  subtitle = "推动教学发展。",
  description = "我们与教育工作者密切合作，来引导、激励求学者，并提供包括课程、指导和工具在内的各种资源，\n为他们的职业发展赋能。",
  cards = []
} = Astro.props;
---

<section class="apple-carousel-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20">
    <!-- 标题区域 -->
    <div class="text-center mb-16">
      <h1 class="apple-carousel-title">{title}</h1>
      <h2 class="apple-carousel-subtitle">{subtitle}</h2>
      <p class="apple-carousel-description">{description}</p>
    </div>

    <!-- 轮播区域 -->
    <div class="apple-carousel-container">
      <div class="apple-carousel-track" id="carouselTrack">
        {cards.map((card, index) => (
          <div class="apple-carousel-slide" data-index={index}>
            <div class="apple-card-image">
              {typeof card.image === 'string' ? (
                <img
                  src={card.image}
                  alt={card.alt || card.title}
                  class="w-full h-auto object-contain"
                  loading="lazy"
                />
              ) : (
                <Image
                  src={card.image}
                  alt={card.alt || card.title}
                  class="w-full h-auto object-contain"
                  loading="lazy"
                  widths={[400, 600, 800, 1000]}
                  sizes="(max-width: 768px) 400px, (max-width: 1200px) 600px, 800px"
                />
              )}
              
              <!-- 文字覆盖层 -->
              <div class="apple-card-overlay">
                <div class="apple-card-content">
                  <h3 class="apple-card-title">{card.title}</h3>
                  <p class="apple-card-subtitle">{card.subtitle}</p>
                </div>
                <button class="apple-card-plus-btn">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <!-- 底部控制 -->
      <div class="apple-carousel-controls">
        <div></div> <!-- 空白占位，保持右侧导航按钮位置 -->
        
        <div class="apple-nav-buttons">
          <button class="apple-nav-btn" id="prevBtn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button class="apple-nav-btn" id="nextBtn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .apple-carousel-section {
    @apply bg-white dark:bg-gray-900;
  }
  
  .apple-carousel-title {
    @apply text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight mb-2 font-heading;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .apple-carousel-subtitle {
    @apply text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight mb-8 font-heading;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .apple-carousel-description {
    @apply text-lg text-gray-600 dark:text-gray-400 max-w-4xl mx-auto leading-relaxed;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    white-space: pre-line;
  }
  
  .apple-carousel-container {
    @apply relative overflow-hidden;
  }
  
  .apple-carousel-track {
    @apply flex transition-transform duration-500 ease-in-out;
    /* 使用 transform 控制位置 */
  }
  
  .apple-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .apple-carousel-slide {
    @apply flex-none;
    width: 100%;
    margin-right: 16px;
  }

  .apple-carousel-slide:last-child {
    margin-right: 0;
  }

  @media (min-width: 768px) {
    .apple-carousel-slide {
      width: 480px;
      margin-right: 32px;
    }
  }

  @media (min-width: 1024px) {
    .apple-carousel-slide {
      width: 600px;
    }
  }
  
  .apple-card-image {
    @apply relative rounded-3xl overflow-hidden;
    /* 移除固定高度，让容器根据图片比例自适应 */
    aspect-ratio: auto;
  }
  
  /* 为图片添加容器样式，保持比例 */
  .apple-card-image img {
    @apply w-full h-auto object-contain;
    /* 使用 object-contain 而不是 object-cover 以避免裁切 */
    display: block;
  }
  
  .apple-card-overlay {
    @apply absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent;
    @apply flex flex-col justify-between p-8;
  }
  
  .apple-card-content {
    @apply mt-auto;
  }
  
  .apple-card-title {
    @apply text-2xl lg:text-3xl font-semibold text-white mb-2 leading-tight;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .apple-card-subtitle {
    @apply text-lg text-white/90 leading-relaxed;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .apple-card-plus-btn {
    @apply absolute top-8 right-8 w-10 h-10 bg-white/20 backdrop-blur-sm rounded-full;
    @apply flex items-center justify-center text-white;
    @apply hover:bg-white/30 transition-all duration-200;
  }
  
  .apple-carousel-controls {
    @apply flex justify-between items-center mt-8;
  }
  
  .apple-play-btn {
    display: none; /* 隐藏播放按钮 */
  }
  
  .apple-nav-buttons {
    @apply flex space-x-2;
  }
  
  .apple-nav-btn {
    @apply w-10 h-10 bg-gray-100 dark:bg-gray-800 rounded-full;
    @apply flex items-center justify-center text-gray-600 dark:text-gray-400;
    @apply hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors;
  }
</style>

<script>
  class AppleCarousel {
    track: HTMLElement | null;
    slides: NodeListOf<Element>;
    prevBtn: HTMLElement | null;
    nextBtn: HTMLElement | null;
    currentIndex: number;
    slideWidth: number;
    visibleSlides: number;
    maxIndex: number;
    
    constructor() {
      this.track = document.getElementById('carouselTrack');
      this.slides = document.querySelectorAll('.apple-carousel-slide');
      this.prevBtn = document.getElementById('prevBtn');
      this.nextBtn = document.getElementById('nextBtn');
      this.currentIndex = 0;
      this.slideWidth = 0;
      this.visibleSlides = 1;
      this.maxIndex = Math.max(0, this.slides.length - this.visibleSlides);

      this.init();
    }
    
    init() {
      this.calculateDimensions();
      this.prevBtn?.addEventListener('click', () => this.prev());
      this.nextBtn?.addEventListener('click', () => this.next());
      
      // 监听窗口大小变化
      window.addEventListener('resize', () => {
        this.calculateDimensions();
        this.updateCarousel();
      });
      
      // 更新按钮状态
      this.updateButtonStates();
    }
    
    getVisibleSlides() {
      const containerWidth = this.track?.parentElement?.offsetWidth || 1200;
      // 根据容器宽度计算可见卡片数
      if (containerWidth >= 1800) return 3; // 增大阈值以适应更大的卡片
      if (containerWidth >= 1200) return 2;
      return 1;
    }
    
    calculateDimensions() {
      const firstSlide = this.slides[0] as HTMLElement;
      if (firstSlide) {
        const style = window.getComputedStyle(firstSlide);
        const marginRight = parseFloat(style.marginRight) || 0;
        this.slideWidth = firstSlide.offsetWidth + marginRight;
      }
      this.visibleSlides = this.getVisibleSlides();
      this.maxIndex = Math.max(0, this.slides.length - this.visibleSlides);

      if (this.currentIndex > this.maxIndex) {
        this.currentIndex = this.maxIndex;
      }
    }
    
    prev() {
      if (this.currentIndex > 0) {
        this.currentIndex--;
        this.updateCarousel();
        this.updateButtonStates();
      }
    }
    
    next() {
      if (this.currentIndex < this.maxIndex) {
        this.currentIndex++;
        this.updateCarousel();
        this.updateButtonStates();
      }
    }
    
    updateCarousel() {
      const translateX = -this.currentIndex * this.slideWidth;
      if (this.track) {
        this.track.style.transform = `translateX(${translateX}px)`;
      }
    }
    
    updateButtonStates() {
      // 更新按钮状态
      if (this.prevBtn) {
        (this.prevBtn as HTMLButtonElement).disabled = this.currentIndex === 0;
        this.prevBtn.style.opacity = this.currentIndex === 0 ? '0.5' : '1';
      }
      
      if (this.nextBtn) {
        (this.nextBtn as HTMLButtonElement).disabled = this.currentIndex >= this.maxIndex;
        this.nextBtn.style.opacity = this.currentIndex >= this.maxIndex ? '0.5' : '1';
      }
    }
  }
  
  const initCarousel = () => new AppleCarousel();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
</script>