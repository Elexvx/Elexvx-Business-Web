---
// *******************************************
// 组件：招聘岗位卡片（单个）                  **
// *******************************************
// 创建时间：2025-01-27                      **
// *******************************************

import type { Job } from '~/data/jobs';

export interface Props {
  job: Job;
  size?: 'sm' | 'md' | 'lg';
}

const { 
  job, 
  size = 'md'
} = Astro.props;

// 根据尺寸设置样式
const sizeClasses = {
  sm: {
    container: 'w-full max-w-sm mx-auto h-full',
    padding: 'p-4',
    title: 'text-lg font-semibold',
    department: 'text-sm',
    description: 'text-sm',
    meta: 'text-xs'
  },
  md: {
    container: 'w-full h-full',
    padding: 'p-6',
    title: 'text-lg font-semibold',
    department: 'text-sm',
    description: 'text-sm',
    meta: 'text-xs'
  },
  lg: {
    container: 'w-full h-full',
    padding: 'p-6',
    title: 'text-xl font-bold',
    department: 'text-base',
    description: 'text-base',
    meta: 'text-sm'
  }
};

const currentSize = sizeClasses[size];

// 工作类型的颜色映射
const typeColors = {
  '全职': 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  '全职或兼职': 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200',
  '兼职': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  '实习': 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
  '远程': 'bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200'
};

// 获取对应的颜色，默认使用绿色
const getTypeColor = (type?: string) => {
  if (!type) return typeColors['全职'];
  return typeColors[type as keyof typeof typeColors] || typeColors['全职'];
};
---

<div class={currentSize.container}>
  <a 
    href={`/company/job/${job.id}`}
    class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 rounded-xl group"
  >
    <article class="w-full h-full bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden flex flex-col">
      <!-- 头部信息 -->
      <div class={`${currentSize.padding} flex flex-col flex-grow`}>
        <!-- 标题和类型 -->
        <div class="flex items-start justify-between gap-3 mb-4">
          <div class="flex-1">
            <h3 class={`${currentSize.title} text-gray-900 dark:text-white leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200`}>
              {job.title}
            </h3>
          </div>
          <span class={`flex-shrink-0 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${getTypeColor(job.type)}`}>
            {job.type}
          </span>
        </div>
        
        <!-- 薪资信息 - 更加凸显 -->
        <div class="mb-4">
          <div class="text-2xl font-bold text-green-600 dark:text-green-400">
            {job.salary}
          </div>
        </div>
        
        <!-- 工作描述 -->
        <div class="flex-grow mb-4">
          <p class={`${currentSize.description} text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-2`}>
            {job.description}
          </p>
        </div>
        
        <!-- 底部元信息 -->
        <div class="space-y-3 pt-4 border-t border-gray-100 dark:border-gray-700">
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
              <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
              <span class={currentSize.meta}>{job.location}</span>
            </div>
            <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
              <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
              </svg>
              <span class={currentSize.meta}>{job.experience}</span>
            </div>
          </div>
          
          <!-- 查看详情提示 -->
          <div class="text-xs text-blue-600 dark:text-blue-400 font-semibold">
            点击查看详情 →
          </div>
        </div>
      </div>
    </article>
  </a>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>