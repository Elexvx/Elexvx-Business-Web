/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

/visuals/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/activities/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=43200, must-revalidate

/sitemap.xsl
  Cache-Control: public, max-age=43200, must-revalidate

/rss.xml
  Cache-Control: public, max-age=43200, must-revalidate

/robots.txt
  Cache-Control: public, max-age=43200, must-revalidate
